<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="MiConexion" connectionString="Data Source=.;Initial Catalog=TRSDiploma;Integrated Security=SSPI;TrustServerCertificate=True"/>
		<add name="MiConexionMaster" connectionString="Data Source=.;Initial Catalog=master;Integrated Security=SSPI;TrustServerCertificate=True"/>
	</connectionStrings>

	<appSettings>
		<add key="CryptoLlave" value="Oscar"/>
	</appSettings>

	<startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
    </startup>
</configuration>